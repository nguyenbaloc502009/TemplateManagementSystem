@model PresentationTemplateSystem.Models.ViewModels.PresentationEditorViewModel
@{
    ViewData["Title"] = "Biên Tập Slide: " + Model.Deck.DeckTitle;
}

<div class="deck-editor-wrapper bg-dark text-white d-flex flex-column" style="min-height: calc(100vh - 120px);">
    <!-- Top Action Bar -->
    <div class="bg-black bg-opacity-75 border-bottom border-secondary border-opacity-50 px-4 py-2">
        <div class="row align-items-center">
            <div class="col-md-5">
                <div class="d-flex align-items-center gap-2">
                    <a href="@Url.Action("Index", "Presentation")" class="btn btn-outline-light btn-sm" title="Quay lại danh sách mẫu">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div class="flex-grow-1">
                        <input type="hidden" id="deckId" value="@Model.Deck.Id" />
                        <input type="text" id="deckTitleInput" class="form-control form-control-sm bg-transparent border-0 text-warning fw-bold fs-6 p-0" 
                               value="@Model.Deck.DeckTitle" title="Nhấp để sửa tên bản trình chiếu" />
                        <div class="small text-light text-opacity-50">
                            Mẫu gốc: <span class="text-white">@(Model.OriginalTemplate?.Title ?? "Bản trình chiếu độc lập")</span>
                            <span class="badge bg-success ms-1"><i class="bi bi-shield-check"></i> Độc lập với template gốc</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-7 text-end d-flex justify-content-end align-items-center gap-2 flex-wrap">
                <span class="badge bg-secondary me-2" id="deckStatusBadge">
                    <i class="bi bi-clock me-1"></i>@Model.Deck.Status
                </span>
                <!-- Nút Lưu Bản Trình Chiếu vào DB -->
                <button type="button" class="btn btn-success fw-bold shadow-sm" id="btnSaveDeck">
                    <i class="bi bi-floppy-fill me-1"></i> Lưu Slide
                </button>
                <!-- Nút Tải xuống file PowerPoint PPTX -->
                <a href="/api/PresentationApi/export-pptx/@Model.Deck.Id" class="btn btn-warning fw-bold text-dark shadow-sm" id="btnDownloadPptx">
                    <i class="bi bi-file-earmark-ppt-fill me-1"></i> Tải PowerPoint (.pptx)
                </a>
                <!-- Nút Trình Chiếu Toàn Màn Hình -->
                <button type="button" class="btn btn-outline-light" id="btnFullScreen">
                    <i class="bi bi-play-fill me-1"></i> Trình Chiếu
                </button>
                <a href="@Url.Action("MyDecks", "Presentation")" class="btn btn-outline-secondary text-white">
                    <i class="bi bi-collection-play me-1"></i> Kho slide
                </a>
            </div>
        </div>
    </div>

    <!-- Main Workspace: Sidebar Slide Thumbnails + Canvas Biên Tập -->
    <div class="d-flex flex-grow-1 overflow-hidden">
        <!-- Sidebar Danh Sách Slides bên trái -->
        <div class="slide-sidebar bg-secondary bg-opacity-10 border-end border-secondary border-opacity-50 p-3 d-flex flex-column" style="width: 260px; min-width: 260px;">
            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary border-opacity-50">
                <span class="fw-bold small text-light text-opacity-75 text-uppercase">Danh sách Slide (<span id="slideCountDisplay">@Model.Slides.Count</span>)</span>
                <button type="button" class="btn btn-warning btn-sm py-0 px-2 fw-bold" id="btnAddSlide" title="Thêm slide mới">
                    <i class="bi bi-plus-lg"></i> Thêm
                </button>
            </div>

            <!-- Danh sách cuộn chứa thumbnails các slide -->
            <div class="slides-list flex-grow-1 overflow-y-auto pe-1" id="slidesThumbList">
                @for (int i = 0; i < Model.Slides.Count; i++)
                {
                    var s = Model.Slides[i];
                    <div class="slide-thumb-item p-2 mb-2 rounded border @(i == 0 ? "active border-warning" : "border-secondary border-opacity-25")" 
                         data-index="@i" style="cursor: pointer;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-dark small">Slide @(i + 1)</span>
                            <button type="button" class="btn btn-link text-danger p-0 btn-delete-slide" data-index="@i" title="Xóa slide này">
                                <i class="bi bi-trash small"></i>
                            </button>
                        </div>
                        <div class="slide-thumb-preview bg-black rounded p-2 text-start" style="height: 75px; overflow: hidden;">
                            <div class="small fw-bold text-truncate text-warning thumb-title">@s.SlideTitle</div>
                            <div class="extra-small text-light text-opacity-75 text-truncate thumb-body">@s.ContentBody</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Canvas Biên Tập Slide ở giữa (Tỷ lệ 16:9 chuẩn) -->
        <div class="slide-canvas-area flex-grow-1 bg-black p-4 d-flex flex-column align-items-center justify-content-center overflow-auto">
            <!-- Slide Canvas 16:9 -->
            <div class="slide-canvas shadow-lg rounded-3 p-5 bg-white text-dark position-relative" id="mainSlideCanvas">
                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-4 fw-bold" id="currentSlideIndicator">Slide 1</span>

                <!-- Tiêu đề Slide -->
                <div class="mb-3">
                    <label class="form-label text-muted small text-uppercase fw-bold m-0">Tiêu đề Slide:</label>
                    <input type="text" id="activeSlideTitle" class="form-control form-control-lg fw-bold text-primary border-0 border-bottom rounded-0 px-0 fs-3" 
                           placeholder="Nhập tiêu đề slide..." value="@(Model.Slides.Count > 0 ? Model.Slides[0].SlideTitle : "")" />
                </div>

                <!-- Phụ đề Slide -->
                <div class="mb-3">
                    <label class="form-label text-muted small text-uppercase fw-bold m-0">Phụ đề (Subtitle):</label>
                    <input type="text" id="activeSlideSubtitle" class="form-control text-muted border-0 border-bottom rounded-0 px-0 fs-5" 
                           placeholder="Nhập phụ đề hoặc thông điệp phụ..." value="@(Model.Slides.Count > 0 ? Model.Slides[0].Subtitle : "")" />
                </div>

                <!-- Nội dung chính của Slide (Bullet points) -->
                <div class="mb-3 flex-grow-1">
                    <label class="form-label text-muted small text-uppercase fw-bold m-0">Nội dung chi tiết (Bullet points):</label>
                    <textarea id="activeSlideBody" class="form-control border-0 bg-light p-3 fs-5 rounded-3" rows="6" 
                              placeholder="Nhập các ý chính hoặc nội dung thuyết trình...">@(Model.Slides.Count > 0 ? Model.Slides[0].ContentBody : "")</textarea>
                </div>

                <!-- Ghi chú diễn giả -->
                <div class="border-top pt-2">
                    <label class="form-label text-muted small text-uppercase fw-bold m-0"><i class="bi bi-chat-quote me-1"></i>Ghi chú diễn giả (Speaker Notes):</label>
                    <input type="text" id="activeSlideNotes" class="form-control form-control-sm border-0 bg-light" 
                           placeholder="Ghi chú nhắc nhở khi thuyết trình..." value="@(Model.Slides.Count > 0 ? Model.Slides[0].Notes : "")" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="application/json" id="slidesInitialData">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Slides))
    </script>
    <script src="~/js/presentation-editor.js" asp-append-version="true"></script>
}

