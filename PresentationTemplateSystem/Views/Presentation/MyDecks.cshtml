@model List<PresentationTemplateSystem.Models.DB.PresentationUserDeckEntity>
@{
    ViewData["Title"] = "Bài Thuyết Trình Của Tôi";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-collection-play-fill text-warning me-2"></i>Kho Bài Thuyết Trình Đã Khởi Tạo
            </h2>
            <p class="text-muted mb-0 small">
                Danh sách các bản trình chiếu được nhân bản độc lập từ bộ mẫu PowerPoint. Bạn có thể mở để tiếp tục biên tập hoặc xuất file PPTX nguyên bản.
            </p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Presentation")" class="btn btn-warning fw-bold text-dark shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Tạo bản trình chiếu mới từ mẫu
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center my-4">
            <div class="my-3">
                <i class="bi bi-easel text-muted display-1 opacity-50"></i>
            </div>
            <h4 class="fw-bold text-dark">Bạn chưa tạo bản trình chiếu nào!</h4>
            <p class="text-muted">Hãy truy cập kho mẫu PowerPoint để chọn và khởi tạo bản trình chiếu đầu tiên của bạn.</p>
            <div class="mt-2">
                <a href="@Url.Action("Index", "Presentation")" class="btn btn-warning fw-bold text-dark px-4">
                    <i class="bi bi-arrow-right me-1"></i> Đến kho mẫu PowerPoint
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;" class="text-center">#</th>
                            <th>Tên bản trình chiếu</th>
                            <th>Bộ mẫu gốc</th>
                            <th>Phân loại</th>
                            <th>Người tạo</th>
                            <th>Trạng thái</th>
                            <th>Cập nhật lần cuối</th>
                            <th class="text-end" style="width: 260px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];
                            <tr>
                                <td class="text-center text-muted">@(i + 1)</td>
                                <td>
                                    <a href="@Url.Action("Editor", "Presentation", new { id = item.Id })" class="fw-bold text-decoration-none text-dark">
                                        <i class="bi bi-file-earmark-slides-fill text-warning me-1"></i> @item.DeckTitle
                                    </a>
                                </td>
                                <td>
                                    <span class="text-muted small">@(item.TemplateTitle ?? "Mẫu độc lập")</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        @(item.CategoryName ?? "Chung")
                                    </span>
                                </td>
                                <td class="small">@item.AuthorName</td>
                                <td>
                                    @if (item.Status == "Saved")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đã lưu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Bản nháp</span>
                                    }
                                </td>
                                <td class="small text-muted">@item.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a href="@Url.Action("Editor", "Presentation", new { id = item.Id })" class="btn btn-outline-dark btn-sm me-1" title="Mở trình soạn thảo slide">
                                        <i class="bi bi-pencil-fill"></i> Biên tập
                                    </a>
                                    <a href="/api/PresentationApi/export-pptx/@item.Id" class="btn btn-warning btn-sm fw-bold text-dark me-1" title="Tải file PowerPoint .pptx">
                                        <i class="bi bi-download"></i> PPTX
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-sm btn-delete-deck" data-id="@item.Id" data-title="@item.DeckTitle" title="Xóa slide">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/presentation-decks.js" asp-append-version="true"></script>
}

