@model DocumentTemplateSystem.Models.ViewModels.DocTemplateListViewModel
@{
    ViewData["Title"] = "Thư Viện Mẫu Văn Bản Tiêu Chuẩn";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- Header & Hero Section -->
    <div class="p-4 mb-4 bg-white rounded-3 shadow-sm border">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-6 fw-bold text-dark mb-2">
                    <i class="bi bi-journal-richtext text-primary me-2"></i>Thư Viện Mẫu Văn Bản Doanh Nghiệp
                </h1>
                <p class="lead text-muted mb-3 fs-6">
                    Tra cứu, xem trước và khởi tạo văn bản nhanh chóng từ kho mẫu chuẩn hóa. Định dạng tài liệu được bảo toàn nguyên vẹn khi xuất file Word (DOCX).
                </p>
                <div class="d-flex flex-wrap gap-2 align-items-center text-muted small">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                        <i class="bi bi-check2-circle me-1"></i> Tối thiểu 5 Mẫu Thử Nghiệm Chuẩn
                    </span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                        <i class="bi bi-shield-check me-1"></i> Bảo Vệ Tuyệt Đối Template Gốc
                    </span>
                    <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2">
                        <i class="bi bi-file-earmark-word me-1"></i> Xuất DOCX Bản Địa OpenXML
                    </span>
                </div>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <div class="card border-0 bg-light p-3 text-start">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">Tổng số mẫu trong hệ thống:</span>
                        <span class="fw-bold fs-5 text-primary">@Model.TotalCount</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">CSDL lưu trữ:</span>
                        <span class="badge bg-secondary">PostgreSQL Real DB</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-2 align-items-center">
                    <!-- Thanh tìm kiếm từ khóa -->
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="keyword" id="txtKeyword" value="@Model.Keyword" class="form-control border-start-0" 
                                   placeholder="Tìm kiếm theo tên mẫu, mô tả hoặc từ khóa..." />
                            @if (!string.IsNullOrEmpty(Model.Keyword))
                            {
                                <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId })" class="btn btn-outline-secondary border-start-0" title="Xóa tìm kiếm">
                                    <i class="bi bi-x-lg"></i>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Dropdown danh mục -->
                    <div class="col-md-4">
                        <select name="categoryId" id="ddlCategory" class="form-select" onchange="this.form.submit()">
                            <option value="">-- Tất cả danh mục văn bản (@Model.Categories.Count) --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.Id" selected="@(Model.SelectedCategoryId == cat.Id)">
                                    @cat.Name
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Nút thao tác -->
                    <div class="col-md-3 d-flex justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary px-4 fw-medium">
                            <i class="bi bi-funnel-fill me-1"></i> Lọc
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
                        </a>
                        <!-- Nút đổi chế độ xem Grid / List -->
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-primary active" id="btnViewGrid" title="Dạng lưới (Grid)">
                                <i class="bi bi-grid-3x3-gap-fill"></i>
                            </button>
                            <button type="button" class="btn btn-outline-primary" id="btnViewList" title="Dạng danh sách (List)">
                                <i class="bi bi-list-ul"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Category Pills (Chọn nhanh) -->
                <div class="d-flex flex-wrap gap-2 mt-3 pt-2 border-top">
                    <span class="small text-muted align-self-center me-1"><i class="bi bi-tags me-1"></i>Danh mục:</span>
                    <a href="@Url.Action("Index", new { keyword = Model.Keyword })" 
                       class="badge text-decoration-none px-3 py-2 @(Model.SelectedCategoryId == null ? "bg-primary text-white" : "bg-light text-dark border")">
                        Tất cả
                    </a>
                    @foreach (var cat in Model.Categories)
                    {
                        <a href="@Url.Action("Index", new { categoryId = cat.Id, keyword = Model.Keyword })" 
                           class="badge text-decoration-none px-3 py-2 @(Model.SelectedCategoryId == cat.Id ? "bg-primary text-white" : "bg-light text-dark border")">
                            <i class="bi @cat.Icon me-1"></i>@cat.Name
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách Mẫu Văn Bản -->
    @if (Model.Templates.Count == 0)
    {
        <!-- Empty State khi không tìm thấy mẫu -->
        <div class="card border-0 shadow-sm p-5 text-center my-4">
            <div class="my-3">
                <i class="bi bi-search text-muted display-1 opacity-50"></i>
            </div>
            <h4 class="fw-bold text-dark">Không tìm thấy mẫu văn bản nào phù hợp!</h4>
            <p class="text-muted">Vui lòng thử tìm với từ khóa khác hoặc chọn lại danh mục văn bản.</p>
            <div class="mt-2">
                <a href="@Url.Action("Index")" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left me-1"></i> Xem tất cả mẫu
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Chế độ xem GRID -->
        <div class="row g-4" id="viewContainerGrid">
            @foreach (var item in Model.Templates)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3 d-flex align-items-stretch">
                    <div class="card template-card h-100 w-100 shadow-sm border-0 rounded-3 overflow-hidden position-relative">
                        <!-- Thumbnail Header -->
                        <div class="template-thumbnail position-relative bg-light border-bottom text-center p-4">
                            <img class="img-fluid rounded shadow-sm" src="@item.ThumbnailUrl" alt="Ảnh xem trước @item.Title" loading="lazy"
                                 onerror="this.onerror=null;this.src='/uploads/thumbnails/document-thumbnail-fallback.svg';" />
                            <span class="badge bg-primary position-absolute top-0 start-0 m-3 shadow-sm">
                                @item.CategoryName
                            </span>
                            <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-3 shadow-sm">
                                <i class="bi bi-download me-1"></i>@item.UsageCount lượt dùng
                            </span>
                        </div>

                        <!-- Card Body -->
                        <div class="card-body d-flex flex-column p-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <span class="badge bg-secondary-subtle text-secondary small">Mã: @item.Code</span>
                            </div>
                            <h5 class="card-title fw-bold text-dark mb-2 line-clamp-2" title="@item.Title">
                                @item.Title
                            </h5>
                            <p class="card-text text-muted small flex-grow-1 line-clamp-3 mb-3">
                                @item.Description
                            </p>
                            @if (!string.IsNullOrEmpty(item.Tags))
                            {
                                <div class="mb-3">
                                    @foreach (var tag in item.Tags.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries).Take(3))
                                    {
                                        <span class="badge bg-light text-dark border me-1 small">#@tag.Trim()</span>
                                    }
                                </div>
                            }

                            <!-- Card Actions -->
                            <div class="d-grid gap-2 pt-2 border-top">
                                <!-- Nút Xem trước (Modal Preview) -->
                                <button type="button" class="btn btn-outline-primary btn-sm fw-medium btn-preview" 
                                        data-id="@item.Id" data-title="@item.Title" data-category="@item.CategoryName" data-desc="@item.Description">
                                    <i class="bi bi-eye-fill me-1"></i> Xem trước mẫu
                                </button>
                                <!-- Nút Sử dụng mẫu (Tạo tài liệu mới) -->
                                <form asp-action="UseTemplate" asp-controller="Document" asp-route-id="@item.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary btn-sm fw-semibold shadow-sm w-100">
                                        <i class="bi bi-pencil-square me-1"></i> Sử dụng mẫu này
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Chế độ xem LIST (mặc định ẩn) -->
        <div class="card border-0 shadow-sm d-none" id="viewContainerList">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 80px;" class="text-center">Biểu tượng</th>
                            <th>Mã &amp; Tên mẫu văn bản</th>
                            <th>Danh mục</th>
                            <th>Mô tả</th>
                            <th class="text-center">Lượt dùng</th>
                            <th class="text-end" style="width: 260px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Templates)
                        {
                            <tr>
                                <td class="text-center">
                                    <div class="rounded-2 bg-primary bg-opacity-10 text-primary p-2 d-inline-block">
                                        <i class="bi bi-file-earmark-word-fill fs-3"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <span class="badge bg-secondary-subtle text-secondary small">@item.Code</span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td class="text-muted small" style="max-width: 320px;">
                                    <div class="text-truncate">@item.Description</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@item.UsageCount</span>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-outline-primary btn-sm me-1 btn-preview" 
                                            data-id="@item.Id" data-title="@item.Title" data-category="@item.CategoryName" data-desc="@item.Description">
                                        <i class="bi bi-eye"></i> Xem trước
                                    </button>
                                    <form asp-action="UseTemplate" asp-controller="Document" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary btn-sm fw-medium">
                                            <i class="bi bi-pencil-square"></i> Dùng mẫu
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- MODAL XEM TRƯỚC MẪU VĂN BẢN (PREVIEW MODAL) -->
<!-- ========================================== -->
<div class="modal fade" id="modalPreview" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text fs-4"></i>
                    <div>
                        <h5 class="modal-title fw-bold" id="previewTitle">Xem trước mẫu văn bản</h5>
                        <span class="badge bg-warning text-dark" id="previewCategory">Danh mục</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="alert alert-info py-2 px-3 small d-flex align-items-center mb-3">
                    <i class="bi bi-info-circle-fill fs-5 me-2"></i>
                    <span>Đây là bản xem trước của mẫu gốc. Khi bấm "Sử dụng mẫu này", hệ thống sẽ tạo một bản sao độc lập để bạn chỉnh sửa mà không ảnh hưởng tới mẫu gốc.</span>
                </div>

                <!-- Tờ giấy A4 hiển thị nội dung mẫu -->
                <div class="paper-preview bg-white shadow-sm p-5 mx-auto rounded border" id="previewContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">Đang tải nội dung xem trước...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                <form id="formUseTemplateModal" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary fw-semibold px-4 shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Sử dụng mẫu này để tạo văn bản mới
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL THÊM MẪU MỚI (UPLOAD TEMPLATE MODAL) -->
<!-- ========================================== -->
<div class="modal fade" id="modalCreateTemplate" tabindex="-1" aria-labelledby="createTemplateLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="createTemplateLabel">
                    <i class="bi bi-plus-circle-fill text-warning me-2"></i>Thêm Mẫu Văn Bản Mới Vào Thư Viện
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="formCreateTemplate">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Mã mẫu văn bản <span class="text-danger">*</span></label>
                            <input type="text" id="newCode" class="form-control" placeholder="VD: DOC-006" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Tên mẫu văn bản <span class="text-danger">*</span></label>
                            <input type="text" id="newTitle" class="form-control" placeholder="VD: Bản Cam Kết Bảo Mật Thông Tin (NDA)" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Danh mục <span class="text-danger">*</span></label>
                            <select id="newCategoryId" class="form-select" required>
                                @foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Thẻ từ khóa (Tags)</label>
                            <input type="text" id="newTags" class="form-control" placeholder="Bảo mật, NDA, Pháp lý, Cam kết" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Mô tả ngắn về mẫu</label>
                            <textarea id="newDescription" class="form-control" rows="2" placeholder="Tóm tắt mục đích sử dụng mẫu..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Nội dung mẫu văn bản (HTML / Soạn thảo) <span class="text-danger">*</span></label>
                            <textarea id="newContentHtml" class="form-control font-monospace" rows="8" placeholder="Nhập cấu trúc nội dung văn bản mẫu..." required></textarea>
                            <div class="form-text">Bạn có thể sử dụng các biến placeholder như <code>{{HoTen}}</code>, <code>{{NgayThang}}</code>, <code>{{TenCongTy}}</code> để người dùng điền sau này.</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-success fw-bold px-4" id="btnSubmitNewTemplate">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Lưu Mẫu Mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/document-index.js" asp-append-version="true"></script>
}
